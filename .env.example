# Required for durable simulations, history and branching. Neon, Supabase and Vercel Postgres are compatible.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/worldsim?sslmode=require"

# TypeSafe AI / Jev. Leave blank to use deterministic bounded decisions only.
JEV_API_KEY=""
JEV_API_URL="https://api.typesafe.ai/v1"
JEV_MODEL="jev-1.13"
# Jev is queried for representative cohorts in the highest-pressure countries on every simulation week.
# Lower this for cheaper/faster runs. Raise cautiously after observing provider limits.
JEV_MAX_COUNTRIES="12"

# Optional narration. Numerical simulation never depends on OpenRouter.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-oss-20b"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
