generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Simulation { id String @id @default(cuid()) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt title String input Json status String @default("queued") result Json? modelVersions Json? checkpoints Checkpoint[] @@index([createdAt]) }
model Checkpoint { id String @id @default(cuid()) simulationId String simulationIdRef Simulation @relation(fields:[simulationId],references:[id],onDelete:Cascade) week Int state Json createdAt DateTime @default(now()) @@unique([simulationId,week]) @@index([simulationId]) }
