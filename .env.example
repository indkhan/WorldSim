# Required for durable simulations, history and branching. Neon, Supabase and Vercel Postgres are compatible.
# Example: postgresql://USER:PASSWORD@HOST:5432/worldsim?sslmode=require
DATABASE_URL=""

# Visitors supply their own OpenRouter key in the app for decisions and narration.
# Jev is queried through OpenRouter for representative cohorts in the highest-pressure countries.
# Lower this for cheaper/faster runs. Raise cautiously after observing provider limits.
DECISION_MAX_COUNTRIES="6"

# Optional narration model. Bounded decisions always use ~typesafe/jev-latest.
OPENROUTER_MODEL="openai/gpt-oss-20b"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared per-run budget for decisions AND narration (no retries).
PROVIDER_MAX_CALLS="24"
PROVIDER_MAX_SECONDS="60"
