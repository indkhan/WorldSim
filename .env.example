# Visitors supply their own OpenRouter key in the app for decisions and narration.
# The shipping lab uses its selected strong model for all 40 actors at planned reviews.
# This country setting controls only the original /legacy simulator.
# Lower this for cheaper/faster runs. Raise cautiously after observing provider limits.
DECISION_MAX_COUNTRIES="6"

# Legacy narration model; legacy decisions retain Jev for compatibility.
# Shipping explicitly selects Sonnet 5.5 or GPT-6.1 Sol in the UI.
OPENROUTER_MODEL="anthropic/claude-sonnet-5.5"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Legacy shared budget; shipping reviews reserve a call for explanation.
# Shipping additionally caps at six reviews + one explanation (25 seconds per request).
PROVIDER_MAX_CALLS="24"
PROVIDER_MAX_SECONDS="60"
